{
  "name": "study-assist-extension",
  "version": "1.2.1",
  "description": "Study Assist Chrome Extension",
  "type": "module",
  "scripts": {
    "validate:multi-answer": "node scripts/validate-multi-answer.js",
    "build": "npm run validate:multi-answer && node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "dev": "node scripts/build.js --watch",
    "package": "npm run validate:multi-answer && node scripts/package.js",
    "package:zip": "npm run validate:multi-answer && node scripts/package.js --zip",
    "release:tag": "node scripts/tag-release.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run tests/detection/netacad.test.ts tests/detection/moodle.test.ts tests/background/parsing.test.ts",
    "test:watch": "vitest",
    "analyze:bank-overlap": "node scripts/analyze-bank-overlap.js"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "esbuild": "^0.20.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
